# Copy to .env and fill in. EXPO_PUBLIC_ vars are exposed to the JS bundle.

# Local Express server base URL (use your dev machine's LAN IP, NOT localhost,
# so phones on the same Wi-Fi can reach it).
EXPO_PUBLIC_SERVER_URL=http://192.168.1.10:4000

# Default admin credentials (first-run only — change in app)
EXPO_PUBLIC_ADMIN_USERNAME=admin
EXPO_PUBLIC_ADMIN_PASSWORD=admin

# Firebase web config (Project settings -> General -> Your apps -> Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
